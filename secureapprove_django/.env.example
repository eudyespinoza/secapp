# ==================================================
# SecureApprove Django - Environment Variables
# ==================================================

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-32-chars-min
DEBUG=True
SECUREAPPROVE_BOOTSTRAP_ADMIN_EMAIL=
SECUREAPPROVE_BOOTSTRAP_ADMIN_PASSWORD=
SECUREAPPROVE_BOOTSTRAP_PRIMARY_EMAIL=

# Database
DB_NAME=secureapprove
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/1

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,secureapprove.com,api.secureapprove.com

# WebAuthn
WEBAUTHN_RP_NAME=SecureApprove
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000

# SecureApprove Proof (use Vault Transit or AWS KMS whenever DEBUG=False)
SECUREAPPROVE_PROOF_ENABLED=False
SECUREAPPROVE_PROOF_MARKETING_ENABLED=False
SECUREAPPROVE_PROOF_SIGNER=local
SECUREAPPROVE_PROOF_ENCRYPTION_BACKEND=local
SECUREAPPROVE_PROOF_SIGNING_KEY_ARN=
SECUREAPPROVE_PROOF_SIGNING_KID=secureapprove-proof-local-v1
SECUREAPPROVE_PROOF_ENCRYPTION_KEY_ARN=
SECUREAPPROVE_VAULT_ADDR=
SECUREAPPROVE_VAULT_TIMEOUT_SECONDS=5
SECUREAPPROVE_VAULT_TRANSIT_MOUNT=transit
SECUREAPPROVE_VAULT_SIGNING_KEY=
SECUREAPPROVE_VAULT_ENCRYPTION_KEY=
SECUREAPPROVE_PROOF_ARCHIVE_ENABLED=False
SECUREAPPROVE_PROOF_ARCHIVE_BUCKET=
SECUREAPPROVE_PROOF_ARCHIVE_RETENTION_DAYS=3650
SECUREAPPROVE_PROOF_ARCHIVE_ENDPOINT_URL=
SECUREAPPROVE_PROOF_ARCHIVE_REGION=us-east-1
SECUREAPPROVE_PROOF_ARCHIVE_ADDRESSING_STYLE=auto
AWS_REGION=us-east-1
VAPID_PRIVATE_KEY=

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@secureapprove.com

# Billing
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_URL=http://localhost:8000/api/billing/webhook/

# Application
APP_NAME=SecureApprove
APP_VERSION=2.0.0
APP_URL=http://localhost:8000
